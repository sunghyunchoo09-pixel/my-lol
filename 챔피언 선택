<!DOCTYPE html>
<html lang="ko">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>League of Legends Client Prototype</title>
    <style>
        * {
            box-sizing: border-box;
            margin: 0;
            padding: 0;
            user-select: none;
        }

        body {
            width: 100vw;
            height: 100vh;
            overflow: hidden;
            background-color: #010a13;
            font-family: 'Arial', sans-serif;
            color: #cdbe91;
            display: flex;
            justify-content: center;
            align-items: center;
        }

        /* 공통 배경 */
        .bg-container {
            position: absolute;
            top: 0; left: 0; width: 100%; height: 100%;
            z-index: 1;
            overflow: hidden;
        }

        .bg-image {
            width: 110%; height: 110%;
            position: absolute; top: -5%; left: -5%;
            background: radial-gradient(circle, rgba(1, 10, 19, 0.4) 0%, rgba(1, 10, 19, 0.95) 100%),
                        url('https://images.unsplash.com/photo-1542751371-adc38448a05e?auto=format&fit=crop&w=1920&q=80') no-repeat center center/cover;
            animation: lolLivingBg 15s ease-in-out infinite alternate;
            filter: brightness(0.7) contrast(1.1);
        }

        @keyframes lolLivingBg {
            0% { transform: scale(1) translate(0, 0); }
            50% { transform: scale(1.05) translate(-10px, -5px); }
            100% { transform: scale(1.03) translate(5px, 8px); }
        }

        #particleCanvas {
            position: absolute;
            top: 0; left: 0; width: 100%; height: 100%;
            z-index: 2;
            pointer-events: none;
        }

        .screen {
            position: absolute;
            top: 0; left: 0; width: 100%; height: 100%;
            z-index: 10;
            display: flex;
            flex-direction: column;
            transition: opacity 0.4s ease;
        }

        .hidden {
            display: none !important;
            opacity: 0;
            pointer-events: none;
        }

        /* SCREEN 1: 메인 로비 */
        .ui-container {
            width: 100%; height: 100%;
            display: flex;
            flex-direction: column;
            justify-content: space-between;
            padding: 30px 50px;
        }

        .top-bar {
            display: flex; align-items: center; gap: 20px;
            background: linear-gradient(180deg, rgba(1, 10, 19, 0.9) 0%, rgba(1, 10, 19, 0) 100%);
            padding-bottom: 20px;
        }

        .play-btn {
            background: linear-gradient(180deg, #1e2328 0%, #010a13 100%);
            border: 2px solid #c8aa6e;
            color: #f0e6d2;
            font-size: 20px; font-weight: bold;
            padding: 12px 45px;
            cursor: pointer;
            letter-spacing: 2px;
            box-shadow: 0 0 15px rgba(0, 0, 0, 0.8);
            transition: all 0.3s;
        }

        .play-btn:hover {
            border-color: #f0e6d2;
            box-shadow: 0 0 20px rgba(200, 170, 110, 0.8);
            transform: scale(1.03);
        }

        .nav-links { display: flex; gap: 30px; font-size: 16px; font-weight: 600; }
        .nav-item { cursor: pointer; color: #a09b8c; }
        .nav-item.active { color: #f0e6d2; text-shadow: 0 0 8px rgba(240, 230, 210, 0.6); }

        .home-content { margin-top: auto; margin-bottom: 50px; max-width: 500px; }
        .champ-title { font-size: 18px; color: #c8aa6e; letter-spacing: 3px; }
        .champ-name { font-size: 56px; font-weight: 900; color: #f0e6d2; margin: 5px 0 15px 0; }
        .champ-desc { font-size: 14px; line-height: 1.6; color: #a09b8c; }

        /* 게임 모드 선택 팝업 */
        .mode-overlay {
            position: absolute;
            top: 90px; left: 50px; right: 50px; bottom: 50px;
            background: rgba(1, 10, 19, 0.92);
            border: 1px solid #785a28;
            box-shadow: 0 0 30px rgba(0, 0, 0, 0.9);
            display: flex; flex-direction: column; padding: 30px;
            z-index: 20;
        }

        .mode-header { display: flex; justify-content: space-between; align-items: center; border-bottom: 1px solid #3c3c41; padding-bottom: 15px; margin-bottom: 30px; }
        .mode-title { font-size: 24px; font-weight: bold; color: #f0e6d2; }
        .close-btn { background: none; border: 1px solid #a09b8c; color: #a09b8c; width: 30px; height: 30px; cursor: pointer; }

        .mode-grid { display: grid; grid-template-columns: repeat(3, 1fr); gap: 20px; height: 100%; }
        .mode-card {
            position: relative; background: #09141e; border: 2px solid #1e2328;
            border-radius: 4px; overflow: hidden; cursor: pointer; transition: all 0.3s;
            display: flex; flex-direction: column; justify-content: flex-end; padding: 25px;
        }
        .mode-card:hover { border-color: #c8aa6e; transform: translateY(-5px); }
        .mode-card.selected { border-color: #00bcbc; box-shadow: 0 0 20px rgba(0, 200, 255, 0.4); }

        .card-bg {
            position: absolute; top: 0; left: 0; width: 100%; height: 100%;
            background: linear-gradient(180deg, rgba(0,0,0,0.2) 0%, rgba(1,10,19,0.95) 100%),
                        url('https://images.unsplash.com/photo-1511512578047-dfb367046420?auto=format&fit=crop&w=600&q=80') center/cover;
            opacity: 0.6; transition: opacity 0.3s;
        }
        .mode-card:hover .card-bg { opacity: 0.9; }

        .card-info { position: relative; z-index: 2; }
        .card-tag { font-size: 12px; color: #008080; font-weight: bold; margin-bottom: 5px; }
        .card-name { font-size: 28px; font-weight: bold; color: #f0e6d2; margin-bottom: 10px; }
        .card-desc { font-size: 13px; color: #a09b8c; line-height: 1.4; }

        .match-start-bar { margin-top: 20px; display: flex; justify-content: center; }
        .confirm-btn {
            background: linear-gradient(180deg, #0596a5 0%, #005a82 100%);
            border: 2px solid #00bcbc; color: #ffffff;
            font-size: 18px; font-weight: bold; padding: 15px 60px;
            cursor: pointer; transition: all 0.3s;
            box-shadow: 0 0 15px rgba(0, 188, 188, 0.5);
        }
        .confirm-btn:hover { transform: scale(1.03); }

        /* 매칭 찾는 중 모달 */
        .matchmaking-overlay {
            position: absolute; top: 0; left: 0; width: 100%; height: 100%;
            background: rgba(1, 10, 19, 0.88);
            display: flex; flex-direction: column; justify-content: center; align-items: center;
            z-index: 50;
        }
        .match-spinner {
            width: 80px; height: 80px;
            border: 4px solid rgba(200, 170, 110, 0.2);
            border-top: 4px solid #c8aa6e;
            border-radius: 50%;
            animation: spin 1s linear infinite;
            margin-bottom: 20px;
        }
        @keyframes spin { 0% { transform: rotate(0deg); } 100% { transform: rotate(360deg); } }
        .match-status { font-size: 24px; color: #f0e6d2; font-weight: bold; letter-spacing: 2px; }
        .match-timer { font-size: 18px; color: #c8aa6e; margin-top: 10px; }

        /* SCREEN 2: 챔피언 선택 화면 */
        .champ-select-container {
            width: 100%; height: 100%;
            background: rgba(1, 10, 19, 0.95);
            display: flex; flex-direction: column;
            padding: 30px;
        }
        .cs-header { text-align: center; margin-bottom: 20px; }
        .cs-title { font-size: 28px; color: #f0e6d2; font-weight: bold; letter-spacing: 2px; }
        .cs-timer { font-size: 36px; color: #c8aa6e; font-weight: bold; margin-top: 5px; }

        .cs-body { display: flex; flex: 1; gap: 30px; }

        .champ-grid {
            flex: 1;
            display: grid;
            grid-template-columns: repeat(4, 1fr);
            gap: 20px;
            padding: 20px;
            background: rgba(9, 20, 30, 0.6);
            border: 1px solid #1e2328;
            align-content: start;
        }

        .champ-card {
            position: relative;
            height: 240px;
            border: 2px solid #785a28;
            border-radius: 4px;
            overflow: hidden;
            cursor: pointer;
            transition: all 0.3s;
        }
        .champ-card:hover { transform: translateY(-5px); border-color: #f0e6d2; box-shadow: 0 0 15px rgba(240, 230, 210, 0.4); }
        .champ-card.selected { border-color: #00bcbc; box-shadow: 0 0 20px rgba(0, 188, 188, 0.8); }

        .champ-img { width: 100%; height: 100%; object-fit: cover; }
        .champ-card-name {
            position: absolute; bottom: 0; left: 0; right: 0;
            background: linear-gradient(0deg, rgba(0,0,0,0.9) 0%, rgba(0,0,0,0) 100%);
            padding: 12px 10px 8px 10px; text-align: center; font-size: 18px; font-weight: bold; color: #f0e6d2;
        }

        .champ-detail-panel {
            width: 360px;
            background: rgba(9, 20, 30, 0.85);
            border: 1px solid #785a28;
            padding: 25px;
            display: flex; flex-direction: column; justify-content: space-between;
        }
        .detail-name { font-size: 32px; color: #f0e6d2; font-weight: bold; margin-bottom: 5px; }
        .detail-role { font-size: 14px; color: #c8aa6e; margin-bottom: 15px; }
        .detail-desc { font-size: 14px; color: #a09b8c; line-height: 1.6; margin-bottom: 20px; }

        .lock-btn {
            width: 100%; padding: 15px;
            background: linear-gradient(180deg, #1e2328 0%, #010a13 100%);
            border: 2px solid #785a28; color: #5c5b57;
            font-size: 18px; font-weight: bold; cursor: not-allowed; transition: all 0.3s;
        }
        .lock-btn.ready {
            background: linear-gradient(180deg, #0596a5 0%, #005a82 100%);
            border-color: #00bcbc; color: #ffffff; cursor: pointer;
            box-shadow: 0 0 15px rgba(0, 188, 188, 0.5);
        }

        /* 완료 상태 모달 */
        .complete-overlay {
            position: absolute; top: 0; left: 0; width: 100%; height: 100%;
            background: rgba(1, 10, 19, 0.92);
            display: flex; flex-direction: column; justify-content: center; align-items: center;
            z-index: 60;
        }
        .complete-box {
            text-align: center;
            border: 2px solid #c8aa6e;
            padding: 40px;
            background: rgba(9, 20, 30, 0.9);
            box-shadow: 0 0 30px rgba(200, 170, 110, 0.3);
        }
        .complete-title { font-size: 32px; color: #f0e6d2; font-weight: bold; margin-bottom: 15px; }
        .complete-sub { font-size: 18px; color: #c8aa6e; margin-bottom: 30px; }
        .reset-btn {
            background: linear-gradient(180deg, #1e2328 0%, #010a13 100%);
            border: 1px solid #c8aa6e; color: #f0e6d2;
            padding: 10px 30px; font-size: 16px; cursor: pointer;
        }
        .reset-btn:hover { border-color: #f0e6d2; }
    </style>
</head>
<body>

    <!-- 라이브 배경 -->
    <div class="bg-container">
        <div class="bg-image"></div>
    </div>
    <canvas id="particleCanvas"></canvas>

    <!-- 1. 메인 로비 화면 -->
    <div class="screen" id="lobbyScreen">
        <div class="ui-container">
            <div class="top-bar">
                <button class="play-btn" id="playBtn">GAME START</button>
                <div class="nav-links">
                    <span class="nav-item active">홈</span>
                    <span class="nav-item">챔피언</span>
                    <span class="nav-item">컬렉션</span>
                    <span class="nav-item">상점</span>
                </div>
            </div>

            <div class="home-content">
                <div class="champ-title">새로운 시작</div>
                <div class="champ-name">소환사의 협곡</div>
                <div class="champ-desc">[GAME START] 버튼을 눌러 일반 게임 대전을 시작하세요.</div>
            </div>
        </div>

        <!-- 모드 선택 팝업 -->
        <div class="mode-overlay hidden" id="modeOverlay">
            <div class="mode-header">
                <div class="mode-title">게임 모드 선택</div>
                <button class="close-btn" id="closeOverlay">✕</button>
            </div>
            <div class="mode-grid">
                <div class="mode-card selected">
                    <div class="card-bg"></div>
                    <div class="card-info">
                        <div class="card-tag">5v5 PvP</div>
                        <div class="card-name">일반 게임</div>
                        <div class="card-desc">소환사의 협곡에서 부담 없이 교전을 즐기는 표준 대전 모드입니다.</div>
                    </div>
                </div>
            </div>
            <div class="match-start-bar">
                <button class="confirm-btn" id="startMatchBtn">일반 게임 찾기</button>
            </div>
        </div>

        <!-- 매칭 찾는 중 모달 -->
        <div class="matchmaking-overlay hidden" id="matchmakingOverlay">
            <div class="match-spinner"></div>
            <div class="match-status">매칭을 찾는 중...</div>
            <div class="match-timer" id="matchTimer">경과 시간: 00:00</div>
        </div>
    </div>

    <!-- 2. 챔피언 선택 화면 -->
    <div class="screen hidden" id="champSelectScreen">
        <div class="champ-select-container">
            <div class="cs-header">
                <div class="cs-title">챔피언을 선택하세요</div>
                <div class="cs-timer" id="selectTimer">30</div>
            </div>
            <div class="cs-body">
                <div class="champ-grid" id="champGrid">
                    <!-- JavaScript에서 4개 챔피언 카드 동적 추가 -->
                </div>
                <div class="champ-detail-panel">
                    <div>
                        <div class="detail-name" id="detailName">챔피언 선택</div>
                        <div class="detail-role" id="detailRole">역할군</div>
                        <div class="detail-desc" id="detailDesc">원하는 챔피언을 클릭하여 지정해 주세요.</div>
                    </div>
                    <button class="lock-btn" id="lockBtn">선택 완료</button>
                </div>
            </div>
        </div>

        <!-- 선택 완료 후 결과 표시 팝업 -->
        <div class="complete-overlay hidden" id="completeOverlay">
            <div class="complete-box">
                <div class="complete-title" id="completeChampTitle">가렌 선택 완료!</div>
                <div class="complete-sub">여기까지 단계가 완성되었습니다. 다음 단계(인게임 연결) 준비 단계입니다.</div>
                <button class="reset-btn" id="resetBtn">처음으로 돌아가기</button>
            </div>
        </div>
    </div>

    <script>
        // 4개의 챔피언 정보
        const champions = [
            {
                id: 'garen',
                name: '가렌',
                role: '전사 / 탱커',
                desc: '데마시아의 힘으로 적을 심판합니다. 높은 리젠 능력과 강력한 스킬 연속기를 보유하고 있습니다.',
                img: 'https://images.unsplash.com/photo-1578632767115-351597cf2477?auto=format&fit=crop&w=400&q=80'
            },
            {
                id: 'darius',
                name: '다리우스',
                role: '전사',
                desc: '녹서스의 실세로서 적들에게 출혈 및 사형 집행 폭딜을 선사합니다.',
                img: 'https://images.unsplash.com/photo-1563089145-599997674d42?auto=format&fit=crop&w=400&q=80'
            },
            {
                id: 'leeSin',
                name: '리 신',
                role: '암살자 / 전사',
                desc: '눈먼 수도승으로 화려한 기동성과 강력한 투사체 스킬샷으로 적을 압도합니다.',
                img: 'https://images.unsplash.com/photo-1534447677768-be436bb09401?auto=format&fit=crop&w=400&q=80'
            },
            {
                id: 'teemo',
                name: '티모',
                role: '원거리 / 마법사',
                desc: '귀여운 외모 속에 치명적인 독침과 귀찮은 버섯 트랩으로 적들을 교란합니다.',
                img: 'https://images.unsplash.com/photo-1566492031773-4f4e44671857?auto=format&fit=crop&w=400&q=80'
            }
        ];

        let selectedChamp = null;
        let matchInterval = null;
        let selectInterval = null;

        // Element 참조
        const lobbyScreen = document.getElementById('lobbyScreen');
        const champSelectScreen = document.getElementById('champSelectScreen');
        const playBtn = document.getElementById('playBtn');
        const modeOverlay = document.getElementById('modeOverlay');
        const closeOverlay = document.getElementById('closeOverlay');
        const startMatchBtn = document.getElementById('startMatchBtn');
        const matchmakingOverlay = document.getElementById('matchmakingOverlay');
        const matchTimer = document.getElementById('matchTimer');

        const champGrid = document.getElementById('champGrid');
        const detailName = document.getElementById('detailName');
        const detailRole = document.getElementById('detailRole');
        const detailDesc = document.getElementById('detailDesc');
        const lockBtn = document.getElementById('lockBtn');
        const selectTimer = document.getElementById('selectTimer');
        
        const completeOverlay = document.getElementById('completeOverlay');
        const completeChampTitle = document.getElementById('completeChampTitle');
        const resetBtn = document.getElementById('resetBtn');

        // 1. GAME START 버튼 클릭 -> 모드 선택 창 Open
        playBtn.addEventListener('click', () => modeOverlay.classList.remove('hidden'));
        closeOverlay.addEventListener('click', () => modeOverlay.classList.add('hidden'));

        // 2. 일반 게임 찾기 클릭 -> 매칭 진행
        startMatchBtn.addEventListener('click', () => {
            modeOverlay.classList.add('hidden');
            matchmakingOverlay.classList.remove('hidden');

            let seconds = 0;
            matchInterval = setInterval(() => {
                seconds++;
                const mins = String(Math.floor(seconds / 60)).padStart(2, '0');
                const secs = String(seconds % 60).padStart(2, '0');
                matchTimer.innerText = `경과 시간: ${mins}:${secs}`;
            }, 1000);

            // 3초 후 매칭 완료 -> 챔피언 선택 화면 이동
            setTimeout(() => {
                clearInterval(matchInterval);
                matchmakingOverlay.classList.add('hidden');
                lobbyScreen.classList.add('hidden');
                champSelectScreen.classList.remove('hidden');
                renderChampSelect();
            }, 3000);
        });

        // 3. 챔피언 선택 화면 초기화 및 렌더링
        function renderChampSelect() {
            champGrid.innerHTML = '';
            selectedChamp = null;

            detailName.innerText = '챔피언 선택';
            detailRole.innerText = '역할군';
            detailDesc.innerText = '원하는 챔피언을 클릭하여 지정해 주세요.';
            lockBtn.classList.remove('ready');
            lockBtn.innerText = '선택 완료';

            champions.forEach(champ => {
                const card = document.createElement('div');
                card.className = 'champ-card';
                card.innerHTML = `
                    <img src="${champ.img}" class="champ-img" alt="${champ.name}">
                    <div class="champ-card-name">${champ.name}</div>
                `;

                card.addEventListener('click', () => {
                    document.querySelectorAll('.champ-card').forEach(c => c.classList.remove('selected'));
                    card.classList.add('selected');
                    
                    selectedChamp = champ;
                    detailName.innerText = champ.name;
                    detailRole.innerText = champ.role;
                    detailDesc.innerText = champ.desc;

                    lockBtn.classList.add('ready');
                    lockBtn.innerText = `${champ.name} 선택 완료`;
                });

                champGrid.appendChild(card);
            });

            // 30초 카운트다운
            let count = 30;
            selectTimer.innerText = count;
            if (selectInterval) clearInterval(selectInterval);
            
            selectInterval = setInterval(() => {
                count--;
                selectTimer.innerText = count;
                if (count <= 0) {
                    clearInterval(selectInterval);
                    if (!selectedChamp) selectedChamp = champions[0]; // 미선택 시 가렌 자동선택
                    finishSelection();
                }
            }, 1000);
        }

        // 4. 선택 완료 (Lock In)
        lockBtn.addEventListener('click', () => {
            if (selectedChamp) {
                if (selectInterval) clearInterval(selectInterval);
                finishSelection();
            }
        });

        function finishSelection() {
            completeChampTitle.innerText = `[${selectedChamp.name}] 선택이 확정되었습니다!`;
            completeOverlay.classList.remove('hidden');
        }

        // 처음으로 리셋
        resetBtn.addEventListener('click', () => {
            completeOverlay.classList.add('hidden');
            champSelectScreen.classList.add('hidden');
            lobbyScreen.classList.remove('hidden');
        });

        // 배경 입자 효과
        const pCanvas = document.getElementById('particleCanvas');
        const pCtx = pCanvas.getContext('2d');
        pCanvas.width = window.innerWidth; pCanvas.height = window.innerHeight;

        const particles = Array.from({ length: 35 }, () => ({
            x: Math.random() * pCanvas.width,
            y: pCanvas.height + Math.random() * 100,
            size: Math.random() * 2 + 0.5,
            speedY: Math.random() * 0.8 + 0.3,
            alpha: Math.random() * 0.7 + 0.3
        }));

        function animateP() {
            pCtx.clearRect(0, 0, pCanvas.width, pCanvas.height);
            particles.forEach(p => {
                p.y -= p.speedY; p.alpha -= 0.002;
                if (p.y < -10 || p.alpha <= 0) {
                    p.x = Math.random() * pCanvas.width;
                    p.y = pCanvas.height + 10;
                    p.alpha = Math.random() * 0.7 + 0.3;
                }
                pCtx.save(); pCtx.globalAlpha = p.alpha; pCtx.fillStyle = '#c8aa6e';
                pCtx.beginPath(); pCtx.arc(p.x, p.y, p.size, 0, Math.PI * 2); pCtx.fill();
                pCtx.restore();
            });
            requestAnimationFrame(animateP);
        }
        animateP();
    </script>
</body>
</html>
